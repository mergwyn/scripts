#!/usr/bin/env bash

#TODO: fill out support for path_policy

# shellcheck source=/dev/null
for function in "$(dirname "$0")"/../functions/*.sh; do source "${function}"; done

cmd=$1
me=$(basename "$0")
export KOPIA_CHECK_FOR_UPDATES=false

# --- Environment Setup ---
case $(uname) in
  Linux)  topdir=~/.config/kopia;;
  Darwin) topdir="~/Library/Application Support/kopia";;
  *)      log_error "Unknown OS"; exit 1;;
esac
config_dir=${topdir}
[[ -d ${topdir} ]] || mkdir -p ${topdir}


declare -a valid_v_store=( idrivee2 minio )
declare -a valid_k_store=( idrivee2 minio )
declare -a valid_ns=( default downloaders home-assistant media monitoring vpn )

validate_type() {
  type=$1
  case ${type} in
    velero*)
      local bucket=velero
      local stem=${type#velero-}
      local store=${stem%%-*}
      local ns=${type#velero-*-}
      if [[ " ${valid_v_store[*]} " =~ " ${store} " ]] ; then
        log_debug "Got valid store ${store}"
      else
        log_error "Invalid store ${store} in ${type}. Needs to be one of '${valid_v_store[*]}'"
        return 1
      fi
      if [[ " ${valid_ns[*]} " =~ " ${ns} " ]] ; then
        log_debug "Got valid ns ${ns}"
      else
        log_error "Invalid namespace ${ns} in ${type}. Needs to be one of '${valid_ns[*]}'"
        return 1
      fi
      ;;
    kopia*)
      store=${type#kopia-}
      if [[ " ${valid_k_store[*]} " =~ " ${store} " ]] ; then
        log_debug "Got valid store ${store}"
      else
        log_error "Invalid store ${store} in ${type}. Needs to be one of '${valid_k_store[*]}'"
        return 1
      fi
      ;;
    kopia-foxtrot|filesystem|rclone)
      ;;
    *)
      log_error Unknown type ${type}
      return 1;;
    # TODO add other types
  esac
  return 0
}

usage1() {
  cat <<EOF >&1
Usage: ${me} <command>

Commands:
  repo
    create repo_type
    connect repo_type
    list
    valid
  system
    install
    certs
  users
    add repo_type
  policy
    global repo_type
    path snapname repo_type [repo_type...]

A repo_type is one of
a) filesystem rclone
b) kopia-<store>
   Valid stores are '${valid_k_store[*]}'
c) velero-<store>-<ns>, where
   Valid stores are '${valid_v_store[*]}'
   Valid ns are '${valid_ns[*]}'
EOF
}


# Load BWS Token (suggested path for your roll-out)
[[ -f "/etc/kopia/.bws_env" ]] && source "/etc/kopia/.bws_env"
[[ -z "${BWS_ACCESS_TOKEN}" ]] && { log_error "BWS_ACCESS_TOKEN not set"; exit 1; }

# --- UUID Configuration ---
declare -A STORE_UUIDS=(
    [idrivee2]="31c6c57d-7a0d-4e3c-afaf-b1ec01031b4f"
    [minio]="232cb3fe-cf1d-493b-b879-b1ec00fe24c5"
    [repo-pw]="500f90e6-0977-40e9-a425-b42100fe869a"
)

# --- Secret Helper ---
load_bws_s3() {
    local store=$1
    local uuid=${STORE_UUIDS[$store]}
    [[ -z "$uuid" ]] && { log_error "No UUID for $store"; return 1; }

    local raw
    raw=$(bws secret get "$uuid" --output json | jq -r '.value')

    # Parses "KEY: VALUE" format from BWS into exports
    while IFS= read -r line; do
        [[ $line == *:* ]] || continue
        # Extract key and value, trimming whitespace
        local k=$(echo "${line%%:*}" | xargs)
        local v=$(echo "${line#*:}" | xargs)
        export "$k"="$v"
    done <<< "$raw"

    # TLS logic: Strict check for minio or internal port 9000
    TLS_FLAG=""
    if [[ "$store" == "minio" ]] || [[ "$ENDPOINT" == *":9000"* ]]; then
        log_debug "Disabling TLS for $store ($ENDPOINT)"
        TLS_FLAG="--disable-tls"
    fi
}

# Load the password (the one Velero is also using)
KOPIA_PASSWORD=$(bws secret get "${STORE_UUIDS[repo-pw]}" --output json | jq -r '.value')

# --- Main Repo Logic ---
connect_repo() {
    local type=$1
    local bucket="kopia"
    local prefix=""

    if ! validate_type ${type} ; then
      log_error "cannot connect, repo $type not supported"
      exit 1
    fi

    if [[ $type == velero-* ]]; then
        local stem=${type#velero-}
        local store=${stem%%-*}
        local ns=${type#velero-*-}
        bucket="velero"
        prefix="kopia/${ns}/"
    else
        local store=${type#kopia-}
    fi

    load_bws_s3 "$store" || return 1

    log_info "Connecting: ${type} -> ${ENDPOINT} [Bucket: ${bucket}]"

    kopia repository connect s3 ${TLS_FLAG} \
        --endpoint="${ENDPOINT}" \
        --bucket="${bucket}" \
        --prefix="${prefix}" \
        --access-key="${ACCESS_KEY_ID}" \
        --secret-access-key="${SECRET_ACCESS_KEY}" \
        --password="${KOPIA_PASSWORD}" \
        --config-file="${config_dir}/${type}.config" \
        --enable-actions \
        --log-level=warning \
        --description="BWS Managed: ${type}"

    export KOPIA_CONFIG_PATH="${config_dir}/${type}.config"
    log_notice "Use 'export KOPIA_CONFIG_PATH=${config_dir}/${type}.config' or '--config-file=${config_dir}/${type}.config' to continue using this repo"
}

global_policy() {
    local type=$1
    connect_repo "$type" || exit 1

    # Your original run-parts action hooks
    local action_base="/bin/run-parts --report /etc/kopia"

    log_info "Setting global policy for ${type}..."
    kopia policy set --global \
        --compression=zstd \
        --keep-latest=0 --keep-hourly=24 --keep-daily=7 --keep-weekly=4 --keep-monthly=12 --keep-annual=0 \
        --ignore-identical-snapshots=false --ignore-unknown-types=true \
        --before-folder-action="" \
        --after-folder-action="" \
        --before-snapshot-root-action="" \
        --after-snapshot-root-action=""
}

path_policy() {
  local path=$1
  shift 1
  source /etc/default/kopia
  for type in ${REPOS}; do
    connect_repo "$type" || exit 1
    log_info "Setting path policy for ${path} on ${type}..."
    kopia policy set "${path}" "$@" \
      --config-file="${config_dir}/${type}.config"
  done
}

# --- Command Switch ---
case ${cmd} in
  repo)
    sub=$2; type=$3
    case ${sub} in
      connect) connect_repo "$type" ;;
      create)
        [[ $type == kopia-* ]] || { log_error "Velero repos are connect-only"; exit 1; }
        load_bws_s3 "${type#kopia-}"
        kopia repository create s3 ${TLS_FLAG} --endpoint="${ENDPOINT}" --bucket="kopia" \
            --access-key="${ACCESS_KEY_ID}" --secret-access-key="${SECRET_ACCESS_KEY}" \
            --password="${KOPIA_PASSWORD}" --config-file="${config_dir}/${type}.config"
        ;;
      list) ls "${config_dir}"/*.config 2>/dev/null | sed 's/\.config$//' ;;
      valid)
    	case $1 in
            velero)
                for((i=0;i<${#valid_v_store[@]};i++)); do
                    for ((j=0;j<${#valid_ns[@]};j++)) ;  do
                        echo velero-${valid_v_store[i]}-${valid_ns[j]}
                    done
                done;;
            kopia)
                for((i=0;i<${#valid_k_store[@]};i++)); do
                    echo kopia-${valid_k_store[i]}
                done;;
            esac
    	;;
    esac
    ;;
  policy)
    case $2 in
      global) global_policy "$3" ;;
      path)   path_policy "$3" "${@:4}" ;;
    esac
    ;;
  system)
    if [[ $2 == "certs" ]]; then
       log_warn "Certs still require kubectl access to the cluster."
       # Insert your original create_cert logic here if still needed
    fi
    ;;
  *) usage1; exit 1 ;;
esac
